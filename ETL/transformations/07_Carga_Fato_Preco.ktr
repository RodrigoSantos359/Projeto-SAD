  <info>
    <name>07_Carga_Fato_Preco</name>
    <description>Busca as surrogate keys (semestre, local, combustivel, bandeira) e grava fato_preco_combustivel.</description>
    <extended_description />
    <trans_version />
    <trans_type>Normal</trans_type>
    <directory>/</directory>
