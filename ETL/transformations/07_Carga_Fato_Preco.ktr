  <step><name>Ler staging limpa</name><type>TableInput</type><description /><distribute>Y</distribute><custom_distribution /><copies>1</copies><partitioning><method>none</method><schema_name /></partitioning><connection>PG_DM_ANP</connection><sql>SELECT l.id_staging, l.id_carga, l.nome_arquivo, l.linha_origem, l.data_coleta, l.produto,
       l.cnpj, l.bandeira, l.valor_venda, l.valor_compra,
       row_to_json(l)::text AS dados_originais, '07_FATO' AS etapa
FROM stg_precos_limpos l
