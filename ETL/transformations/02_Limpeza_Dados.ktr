    <jsScripts>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Inicializacao</jsScript_name>
        <jsScript_script>
// ---------------------------------------------------------------------------
// Corrige textos com "mojibake": UTF-8 que foi lido como Windows-1252 e salvo
// de novo (ex.: "SÃƒO" -&gt; "SÃO", "R$ / mÂ³" -&gt; "R$ / m³").
// So troca o valor quando os bytes formam UTF-8 valido; caso contrario mantem.
// ---------------------------------------------------------------------------
var CP1252 = {};
var CP1252_PARES = [[0x20AC,0x80],[0x201A,0x82],[0x0192,0x83],[0x201E,0x84],[0x2026,0x85],[0x2020,0x86],
  [0x2021,0x87],[0x02C6,0x88],[0x2030,0x89],[0x0160,0x8A],[0x2039,0x8B],[0x0152,0x8C],[0x017D,0x8E],
  [0x2018,0x91],[0x2019,0x92],[0x201C,0x93],[0x201D,0x94],[0x2022,0x95],[0x2013,0x96],[0x2014,0x97],
  [0x02DC,0x98],[0x2122,0x99],[0x0161,0x9A],[0x203A,0x9B],[0x0153,0x9C],[0x017E,0x9E],[0x0178,0x9F]];
for (var i = 0; i &lt; CP1252_PARES.length; i++) CP1252[CP1252_PARES[i][0]] = CP1252_PARES[i][1];
var SUSPEITO = /[\u00C2\u00C3]/;

function corrigirTexto(v) {
  if (v == null) return v;
  var s = String(v);
  if (!SUSPEITO.test(s)) return v;
  var bytes = java.lang.reflect.Array.newInstance(java.lang.Byte.TYPE, s.length);
  for (var i = 0; i &lt; s.length; i++) {
    var c = s.charCodeAt(i);
    var b = c &lt;= 0xFF ? c : CP1252[c];
    if (b === undefined) return v;          // caractere fora do Windows-1252: nao e mojibake
    bytes[i] = b &gt; 127 ? b - 256 : b;
  }
  var r = String(new java.lang.String(bytes, "UTF-8"));
  if (r.indexOf("�") &gt;= 0) return v;  // nao era UTF-8 valido: texto original mantido
  return r;
}
</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Por linha</jsScript_name>
        <jsScript_script>regiao = corrigirTexto(regiao);
