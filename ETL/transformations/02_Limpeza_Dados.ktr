rua = corrigirTexto(rua);
numero = corrigirTexto(numero);
complemento = corrigirTexto(complemento);
bairro = corrigirTexto(bairro);
cep = corrigirTexto(cep);
produto = corrigirTexto(produto);
data_coleta = corrigirTexto(data_coleta);
valor_venda = corrigirTexto(valor_venda);
valor_compra = corrigirTexto(valor_compra);
unidade_medida = corrigirTexto(unidade_medida);
bandeira = corrigirTexto(bandeira);</jsScript_script>
      </jsScript>
    </jsScripts>
