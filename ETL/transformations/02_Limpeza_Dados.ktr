    <jsScripts>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Inicializacao</jsScript_name>
        <jsScript_script>
// ---------------------------------------------------------------------------
// Executado uma vez: constantes e funcoes de conversao/validacao.
// ---------------------------------------------------------------------------
var UFS_VALIDAS = "AC,AL,AP,AM,BA,CE,DF,ES,GO,MA,MT,MS,MG,PA,PB,PR,PE,PI,RJ,RN,RS,RO,RR,SC,SP,SE,TO".split(",");
var UF_ALVO = String(getVariable("UF_ALVO", "PE")).replace(/^\s+|\s+$/g, "").toUpperCase();
var DT_INI = java.time.LocalDate.parse(String(getVariable("DATA_INICIO", "2021-01-01")).replace(/^\s+|\s+$/g, ""));
var DT_FIM = java.time.LocalDate.parse(String(getVariable("DATA_FIM", "2026-06-30")).replace(/^\s+|\s+$/g, ""));
var EXCEL_BASE = java.time.LocalDate.of(1899, 12, 30);
var INVALIDO = { invalido: true };

// O layout bruto da ANP nao traz o nome do estado nem a categoria do combustivel:
// os dois sao derivados aqui (UF -&gt; nome do estado; PRODUTO -&gt; categoria).
var NOME_UF = { AC: "Acre", AL: "Alagoas", AP: "Amapa", AM: "Amazonas", BA: "Bahia", CE: "Ceara",
  DF: "Distrito Federal", ES: "Espirito Santo", GO: "Goias", MA: "Maranhao", MT: "Mato Grosso",
  MS: "Mato Grosso do Sul", MG: "Minas Gerais", PA: "Para", PB: "Paraiba", PR: "Parana",
  PE: "Pernambuco", PI: "Piaui", RJ: "Rio de Janeiro", RN: "Rio Grande do Norte",
  RS: "Rio Grande do Sul", RO: "Rondonia", RR: "Roraima", SC: "Santa Catarina", SP: "Sao Paulo",
  SE: "Sergipe", TO: "Tocantins" };

// GASOLINA, GASOLINA ADITIVADA -&gt; GASOLINA; DIESEL, DIESEL S10, DIESEL S50 -&gt; DIESEL; ETANOL; GNV
function categoriaDe(p) {
  if (vazio(p)) return null;
  var s = String(p).toUpperCase();
  if (s.indexOf("GASOLINA") == 0) return "GASOLINA";
  if (s.indexOf("DIESEL") == 0) return "DIESEL";
  if (s.indexOf("ETANOL") == 0) return "ETANOL";
  if (s.indexOf("GNV") == 0) return "GNV";
  return null;   // produto desconhecido: categoria fica NULL (nao inventamos)
}

function vazio(v) {
  return v == null || String(v).replace(/^\s+|\s+$/g, "") == "";
}

// "5,89" | "R$ 5,89" | "5.89" | "3.5999999999999996" -&gt; BigDecimal com 2 casas (arredonda: 4,599 -&gt; 4,60)
function converterValor(v) {
  if (vazio(v)) return null;
  var s = String(v).toUpperCase().replace(/R\$/g, "").replace(/\s+/g, "");
  if (s.indexOf(",") &gt;= 0) {
    s = s.replace(/\./g, "").replace(",", ".");   // formato brasileiro: 1.234,56
  }
  if (!/^-?\d+(\.\d+)?$/.test(s)) return INVALIDO;
  return new java.math.BigDecimal(s).setScale(2, java.math.RoundingMode.HALF_UP);
}

// "2024-03-01" | "01/03/2024" | "45352" (serial do Excel) -&gt; LocalDate
function converterData(v) {
  if (vazio(v)) return null;
  var s = String(v).replace(/^\s+|\s+$/g, "");
  var m, a, mes, d;
  if ((m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})(\s.*)?$/))) { a = m[1]; mes = m[2]; d = m[3]; }
  else if ((m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})(\s.*)?$/))) { d = m[1]; mes = m[2]; a = m[3]; }
  else if ((m = s.match(/^(\d{5})(\.0+)?$/))) { return EXCEL_BASE.plusDays(parseInt(m[1], 10)); }
  else return INVALIDO;
  try {
    return java.time.LocalDate.of(parseInt(a, 10), parseInt(mes, 10), parseInt(d, 10));
  } catch (ex) {
    return INVALIDO;   // ex.: 31/02/2024
  }
}

function mostrar(v) { return v == null ? "&lt;nulo&gt;" : "[" + v + "]"; }
</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Por linha</jsScript_name>
        <jsScript_script>
var motivo = null;
var erros = [];
var destino = "VALIDO";
var detalhe = null;
var uf = vazio(estado) ? null : String(estado).toUpperCase();
var cnpj_fmt = null;
var data_coleta_dt = null;
var valor_venda_num = null;
var valor_compra_num = null;
var bandeira_fmt = vazio(bandeira) ? "NAO INFORMADA" : String(bandeira);

function rejeitar(m, d) { if (motivo == null) motivo = m; erros.push(m + ": " + d); }

// 1) Filtro geografico
if (uf == null || UFS_VALIDAS.indexOf(uf) &lt; 0) {
  rejeitar("UF_INVALIDA", "estado=" + mostrar(estado));
} else if (uf != UF_ALVO) {
  destino = "FORA_ESCOPO";
  detalhe = "UF diferente de " + UF_ALVO;
}

if (destino != "FORA_ESCOPO") {
  // 2) Campos obrigatorios
  if (vazio(produto)) rejeitar("COMBUSTIVEL_NULO", "produto vazio");
  if (vazio(municipio)) rejeitar("CAMPO_OBRIGATORIO_NULO", "municipio vazio");
  if (vazio(cnpj)) {
    rejeitar("CAMPO_OBRIGATORIO_NULO", "cnpj vazio");
  } else {
    var dig = String(cnpj).replace(/\D/g, "");
    if (dig.length != 14) rejeitar("CNPJ_INVALIDO", "cnpj=" + mostrar(cnpj));
    else cnpj_fmt = dig.substr(0, 2) + "." + dig.substr(2, 3) + "." + dig.substr(5, 3) + "/" + dig.substr(8, 4) + "-" + dig.substr(12, 2);
  }

  // 3) Data da coleta
  var d = converterData(data_coleta);
  if (d == null || d === INVALIDO) {
    rejeitar("DATA_INVALIDA", "data_coleta=" + mostrar(data_coleta));
  } else {
    if (d.isBefore(DT_INI) || d.isAfter(DT_FIM)) {
      destino = "FORA_ESCOPO";
      detalhe = "data fora do periodo " + DT_INI + " a " + DT_FIM;
    }
    data_coleta_dt = java.sql.Date.valueOf(d);
  }

  // 4) Valores monetarios
  var vv = converterValor(valor_venda);
  if (vv == null || vv === INVALIDO || vv.signum() &lt;= 0) rejeitar("VALOR_VENDA_INVALIDO", "valor_venda=" + mostrar(valor_venda));
  else valor_venda_num = vv;

  var vc = converterValor(valor_compra);
  if (vc === INVALIDO || (vc != null &amp;&amp; vc.signum() &lt; 0)) rejeitar("VALOR_COMPRA_INVALIDO", "valor_compra=" + mostrar(valor_compra));
  else if (vc != null &amp;&amp; vc.signum() &gt; 0) valor_compra_num = vc;   // 0 = nao informado -&gt; NULL
}

if (destino != "FORA_ESCOPO" &amp;&amp; motivo != null) {
  destino = "REJEITADO";
  detalhe = erros.join(" | ");
}

var estado_nome = (uf != null &amp;&amp; NOME_UF[uf] !== undefined) ? NOME_UF[uf] : null;
var categoria = categoriaDe(produto);
</jsScript_script>
      </jsScript>
    </jsScripts>
