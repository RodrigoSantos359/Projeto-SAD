<transformation>
  <info>
    <name>03_Dim_Tempo</name>
    <description>Gera a dim_tempo SEMESTRAL: um registro por semestre entre DATA_INICIO e DATA_FIM.</description>
    <extended_description />
    <trans_version />
    <trans_type>Normal</trans_type>
    <directory>/</directory>
