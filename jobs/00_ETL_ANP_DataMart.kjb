      <logmessage>ETL concluido. Consulte etl_controle_carga e etl_rejeitados.</logmessage>
      <loglevel>Basic</loglevel>
      <logsubject>ETL ANP</logsubject>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>1850</xloc>
