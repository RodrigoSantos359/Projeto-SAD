    <entry>
      <name>Registrar ERRO no controle</name>
      <description />
      <type>SQL</type>
      <attributes />
      <sql>UPDATE etl_controle_carga
   SET status   = 'ERRO',
       data_fim = now(),
       mensagem = 'Falha na execucao do job 00_ETL_ANP_DataMart. Consulte o log do Spoon/Kitchen.'
 WHERE status = 'PROCESSANDO';</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename />
      <sendOneStatement>F</sendOneStatement>
      <connection>PG_DM_ANP</connection>
