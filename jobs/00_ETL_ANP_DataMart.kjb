    <entry>
      <name>Atualizar controle da carga</name>
      <description />
      <type>SQL</type>
      <attributes />
      <sql>UPDATE etl_controle_carga c
   SET quantidade_lida       = x.lida + COALESCE(c.quantidade_outras_uf, 0),
       quantidade_outras_uf  = COALESCE(c.quantidade_outras_uf, 0),
       quantidade_processada = x.processada,
       quantidade_rejeitada  = x.rejeitada,
       quantidade_fora_escopo = COALESCE(c.quantidade_outras_uf, 0) + x.lida - x.processada - x.rejeitada,
       data_fim = now(),
       status   = 'CONCLUIDO',
       mensagem = 'Carga concluida com sucesso'
  FROM (SELECT c2.id_carga,
               (SELECT count(*) FROM stg_precos_combustiveis s WHERE s.nome_arquivo = c2.nome_arquivo) AS lida,
               (SELECT count(*) FROM fato_preco_combustivel f  WHERE f.id_carga = c2.id_carga)         AS processada,
               (SELECT count(*) FROM etl_rejeitados r          WHERE r.id_carga = c2.id_carga)         AS rejeitada
          FROM etl_controle_carga c2
         WHERE c2.status = 'PROCESSANDO') x
 WHERE c.id_carga = x.id_carga;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename />
      <sendOneStatement>F</sendOneStatement>
      <connection>PG_DM_ANP</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>1720</xloc>
      <yloc>120</yloc>
      <attributes_kjc />
    </entry>
