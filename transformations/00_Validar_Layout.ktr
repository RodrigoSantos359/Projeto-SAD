  <step>
    <name>Comparar com LAYOUT_ESPERADO</name>
    <type>ScriptValueMod</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Inicializacao</jsScript_name>
        <jsScript_script>
var esperado = String(getVariable("LAYOUT_ESPERADO", "")).split(";");
for (var i = 0; i &lt; esperado.length; i++) { esperado[i] = esperado[i].replace(/^\s+|\s+$/g, "").toUpperCase(); }
function norm(v) {
  if (v == null) return "";
  return String(v).replace(/^\uFEFF/, "").replace(/^\s+|\s+$/g, "").toUpperCase();
}
</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Por linha</jsScript_name>
        <jsScript_script>
var lidos = [c01, c02, c03, c04, c05, c06, c07, c08, c09, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21];
var cab = [];
var difs = [];
for (var i = 0; i &lt; Math.max(esperado.length, lidos.length); i++) {
  var lido = i &lt; lidos.length ? norm(lidos[i]) : "";
  var esp = i &lt; esperado.length ? esperado[i] : "";
  if (lido != "") cab.push(lido);
  if (lido != esp) difs.push("coluna " + (i + 1) + ": esperado [" + esp + "] encontrado [" + lido + "]");
}
var cabecalho_lido = cab.join(";");
var layout_ok = difs.length == 0 ? "S" : "N";
var divergencias = difs.join(" | ");
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>cabecalho_lido</name>
        <rename>cabecalho_lido</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>layout_ok</name>
        <rename>layout_ok</rename>
        <type>String</type>
        <length>-1</length>
