<?xml version='1.0' encoding='UTF-8'?>
<transformation>
  <info>
    <name>00_Validar_Layout</name>
    <description>Le a primeira linha (cabecalho) de cada arquivo da pasta de entrada e compara com LAYOUT_ESPERADO. Aborta o job se alguma coluna estiver faltando, sobrando ou fora de ordem.</description>
    <extended_description />
    <trans_version />
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>CSV_SEPARADOR</name>
        <default_value>;</default_value>
        <description>Separador dos arquivos CSV</description>
      </parameter>
      <parameter>
        <name>DATA_FIM</name>
        <default_value>2026-06-30</default_value>
        <description>Ultima data aceita (yyyy-MM-dd)</description>
      </parameter>
      <parameter>
        <name>DATA_INICIO</name>
        <default_value>2020-01-01</default_value>
        <description>Primeira data aceita (yyyy-MM-dd)</description>
      </parameter>
      <parameter>
        <name>DIR_ENTRADA</name>
        <default_value>${Internal.Entry.Current.Directory}/../data/input</default_value>
        <description>Pasta com os arquivos da ANP (.xlsx/.csv)</description>
      </parameter>
      <parameter>
        <name>LAYOUT_ESPERADO</name>
        <default_value>Regiao - Sigla;Estado - Sigla;Municipio;Revenda;CNPJ da Revenda;Nome da Rua;Numero Rua;Complemento;Bairro;Cep;Produto;Data da Coleta;Valor de Venda;Valor de Compra;Unidade de Medida;Bandeira</default_value>
        <description>Cabecalho esperado (colunas separadas por ;)</description>
      </parameter>
      <parameter>
        <name>PG_DB</name>
        <default_value>dm_anp_pernambuco</default_value>
        <description>Banco do Data Mart</description>
      </parameter>
      <parameter>
        <name>PG_HOST</name>
        <default_value>localhost</default_value>
        <description>Servidor PostgreSQL</description>
      </parameter>
      <parameter>
        <name>PG_PASSWORD</name>
        <default_value>postgres</default_value>
        <description>Senha PostgreSQL</description>
      </parameter>
      <parameter>
        <name>PG_PORT</name>
        <default_value>5432</default_value>
        <description>Porta PostgreSQL</description>
      </parameter>
      <parameter>
        <name>PG_USER</name>
        <default_value>postgres</default_value>
        <description>Usuario PostgreSQL</description>
      </parameter>
      <parameter>
        <name>UF_ALVO</name>
        <default_value>PE</default_value>
        <description>UF do Data Mart</description>
      </parameter>
    </parameters>
